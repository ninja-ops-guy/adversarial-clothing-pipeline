{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rac-cohort-manifest/1.0",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "cohort_id": {"type": "string", "pattern": "^RAC-(COHORT|COH)-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "experiment_id": {"type": "string", "pattern": "^RAC-EXP-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "sampling_id": {"type": "string", "pattern": "^RAC-SAMP-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "constraint_set_id": {"type": "string", "pattern": "^RAC-CS-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "code_version": {"type": "string", "minLength": 1},
    "pipeline_id": {"type": "string", "pattern": "^RAC-PIPE-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "pipeline_version": {"type": "string", "minLength": 1},
    "calibration_id": {"type": "string", "pattern": "^RAC-CAL-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "calibration_version": {"type": "string", "minLength": 1},
    "diagnostic_threshold_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "specimen_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["schema_version", "cohort_id", "experiment_id", "specimen_ids"],
  "oneOf": [
    {
      "required": [
        "sampling_id",
        "constraint_set_id",
        "code_commit",
        "code_version",
        "pipeline_id",
        "pipeline_version",
        "calibration_id",
        "calibration_version",
        "diagnostic_threshold_hash",
        "artifacts"
      ]
    },
    {
      "required": ["artifact_sha256"],
      "not": {
        "anyOf": [
          {"required": ["sampling_id"]},
          {"required": ["constraint_set_id"]},
          {"required": ["code_version"]},
          {"required": ["pipeline_id"]},
          {"required": ["calibration_id"]},
          {"required": ["diagnostic_threshold_hash"]},
          {"required": ["artifacts"]}
        ]
      }
    }
  ],
  "additionalProperties": true
}
