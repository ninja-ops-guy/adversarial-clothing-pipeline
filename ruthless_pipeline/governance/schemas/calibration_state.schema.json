{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rac-calibration-state/1.0",
  "type": "object",
  "required": ["schema_version", "calibration_id", "member_ids", "state_hash", "source_manifest_hash", "random_seed", "outcome_labels_consumed"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "calibration_id": {"type": "string", "pattern": "^RAC-CAL-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "member_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "random_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "outcome_labels_consumed": {"const": false}
  },
  "additionalProperties": false
}
