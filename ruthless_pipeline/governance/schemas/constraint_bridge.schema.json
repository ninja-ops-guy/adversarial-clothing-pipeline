{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"rac-constraint-bridge/1.0",
  "type":"object",
  "required":["schema_version","bridge_id","old_constraint_id","new_constraint_id","specimen_ids","sampling_manifest_id","source_policy"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "bridge_id":{"type":"string","pattern":"^RAC-BRG-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "old_constraint_id":{"type":"string","pattern":"^RAC-CST-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "new_constraint_id":{"type":"string","pattern":"^RAC-CST-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "specimen_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "sampling_manifest_id":{"type":"string","pattern":"^RAC-SMP-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "source_policy":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
