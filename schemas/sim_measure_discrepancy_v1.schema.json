{
  "$id": "https://rac.local/schemas/sim_measure_discrepancy_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAC Simulation-Measurement Discrepancy v1 (SW-13)",
  "description": "Neutral prediction/observation comparison. measured_distribution and residual are null until measured data is supplied; a comparison without a measured counterpart is always synthetic_pipeline_validation_only and cannot promote.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "rac-sim-measure-discrepancy/1.0"},
    "comparison_id": {"type": "string", "pattern": "^RAC-DISC-[0-9a-f]{16}$"},
    "simulator_id": {"type": "string", "minLength": 1},
    "simulator_version": {"type": "string", "minLength": 1},
    "simulator_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metric_name": {"type": "string", "minLength": 1},
    "predicted_distribution": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "measured_distribution": {"type": ["array", "null"], "items": {"type": "number"}},
    "residual": {"type": ["array", "null"], "items": {"type": "number"}},
    "uncertainty": {"type": ["object", "null"]},
    "calibration_set_ref": {"type": ["string", "null"]},
    "evaluation_set_ref": {"type": ["string", "null"]},
    "evidence_class": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version", "comparison_id", "simulator_id", "simulator_version",
    "simulator_content_sha256", "metric_name", "predicted_distribution",
    "measured_distribution", "residual", "uncertainty",
    "calibration_set_ref", "evaluation_set_ref", "evidence_class"
  ]
}
