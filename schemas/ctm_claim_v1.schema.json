{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rac.local/schemas/ctm_claim_v1.schema.json",
  "title": "RAC CTM Claim v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","claim_id","state","feature_id","outcome_id","source_commit","independent_cohort_count","matched_null_design_ids","consumed_artifacts"],
  "properties": {
    "schema_version": {"const":"rac-ctm/1.0"},
    "claim_id": {"type":"string","minLength":1},
    "state": {"enum":["correlation","association","controlled_effect"]},
    "feature_id": {"type":"string","minLength":1},
    "outcome_id": {"type":"string","minLength":1},
    "source_commit": {"type":"string","minLength":1},
    "independent_cohort_count": {"type":"integer","minimum":1},
    "matched_null_design_ids": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "consumed_artifacts": {
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["artifact_id","role","sha256","heldout_access","heldout_feedback_used","selection_influence","metadata"],
        "properties":{
          "artifact_id":{"type":"string","minLength":1},
          "role":{"enum":["doe","generator","acceptance","genome","surrogate_observation","heldout_observation","physical_observation","null_design","claim"]},
          "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "heldout_access":{"type":"boolean"},
          "heldout_feedback_used":{"type":"boolean"},
          "selection_influence":{"enum":["NONE_MEASUREMENT_ONLY","SURROGATE_ONLY","POST_FREEZE_ANALYSIS_ONLY","NOT_APPLICABLE"]},
          "metadata":{"type":"object"}
        }
      }
    },
    "notes":{"type":"array","items":{"type":"string"}}
  }
}
