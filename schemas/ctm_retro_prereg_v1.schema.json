{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rac.local/schemas/ctm_retro_prereg_v1.schema.json",
  "title": "RAC CTM SPEC-7 Retro-Mining Preregistration v1 (additive)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","created_utc","minimum_useful_effect","minimum_analyzable_cohort","min_power","max_heterogeneity","multiplicity_correction","missing_data_policy","predictor_families","luminance_baseline","stratification_axes"],
  "properties": {
    "schema_version": {"const":"rac-ctm-retro-prereg/1.0"},
    "created_utc": {"type":"string","minLength":1},
    "minimum_useful_effect": {"type":"number","exclusiveMinimum":0},
    "minimum_analyzable_cohort": {"type":"integer","minimum":2},
    "min_power": {"type":"number","exclusiveMinimum":0,"maximum":1},
    "max_heterogeneity": {"type":"number","minimum":0,"maximum":1},
    "multiplicity_correction": {"enum":["holm","bonferroni","bh"]},
    "missing_data_policy": {"enum":["complete_case","stratum_specific"]},
    "predictor_families": {
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"enum":["harmonic_energy_curve","description_length","group_risk","persistence_summary"]}
    },
    "luminance_baseline": {"type":"string","minLength":1},
    "stratification_axes": {
      "type":"array","minItems":4,"uniqueItems":true,
      "items":{"enum":["target_head_class","channel_class","threshold_regime","cohort"]}
    }
  }
}
