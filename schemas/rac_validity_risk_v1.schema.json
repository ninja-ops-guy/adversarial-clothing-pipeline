{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rac.local/schemas/rac_validity_risk_v1.schema.json",
  "title": "RAC Canonical Validity Risk v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "risk_id",
    "category",
    "affected_experiment_class",
    "severity",
    "description",
    "mitigation",
    "residual_risk",
    "status",
    "closure_evidence",
    "source_refs",
    "uncertainty"
  ],
  "properties": {
    "risk_id": {"type": "string", "pattern": "^RAC-RISK-[0-9a-f]{16}$"},
    "category": {
      "enum": [
        "simulation_gap",
        "model_selection",
        "manufacturing_variance",
        "statistical_power",
        "temporal_dependence",
        "other"
      ]
    },
    "affected_experiment_class": {"type": "string", "minLength": 1},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "description": {"type": "string", "minLength": 1},
    "mitigation": {"type": "string", "minLength": 1},
    "residual_risk": {"type": "string", "minLength": 1},
    "status": {"enum": ["open", "mitigated", "closed"]},
    "closure_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "note"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "note": {"type": "string"}
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "uncertainty": {"enum": ["high", "medium", "low"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "closed"}}},
      "then": {"properties": {"closure_evidence": {"minItems": 1}}}
    }
  ]
}
