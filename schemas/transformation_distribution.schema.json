{
  "$id": "https://rac.example/schemas/transformation_distribution.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAC Transformation Distribution Manifest",
  "description": "Frozen Barrier 1 contract for the 4-dimension-group transformation distribution parameter manifest. A sample is reproducible from (distribution_id, manifest, seed, sample_index). Robustness output is a per-dimension response grid (robustness surface), never a scalar-only average.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["uniform", "normal", "lognormal", "choice", "fixed"]
        },
        "params": {
          "type": "object",
          "description": "Distribution parameters, e.g. {min,max} for uniform, {mean,std} for normal/lognormal, {values:[...]} for choice, {value:...} for fixed.",
          "minProperties": 1
        }
      },
      "required": ["type", "params"]
    },
    "geometryGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scale": {"$ref": "#/$defs/distribution"},
        "camera_distance": {"$ref": "#/$defs/distribution"},
        "perspective": {"$ref": "#/$defs/distribution"},
        "yaw": {"$ref": "#/$defs/distribution"},
        "pitch": {"$ref": "#/$defs/distribution"},
        "roll": {"$ref": "#/$defs/distribution"},
        "translation": {"$ref": "#/$defs/distribution"}
      },
      "required": [
        "scale",
        "camera_distance",
        "perspective",
        "yaw",
        "pitch",
        "roll",
        "translation"
      ]
    },
    "imagingGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blur": {"$ref": "#/$defs/distribution"},
        "resize_interpolation": {"$ref": "#/$defs/distribution"},
        "compression": {"$ref": "#/$defs/distribution"},
        "exposure": {"$ref": "#/$defs/distribution"},
        "contrast": {"$ref": "#/$defs/distribution"}
      },
      "required": ["blur", "resize_interpolation", "compression", "exposure", "contrast"]
    },
    "garmentGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stretch": {"$ref": "#/$defs/distribution"},
        "wrinkle": {"$ref": "#/$defs/distribution"},
        "fold": {"$ref": "#/$defs/distribution"},
        "bend": {"$ref": "#/$defs/distribution"},
        "partial_occlusion": {"$ref": "#/$defs/distribution"}
      },
      "required": ["stretch", "wrinkle", "fold", "bend", "partial_occlusion"]
    },
    "printCaptureGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gamut_mapping": {"$ref": "#/$defs/distribution"},
        "resolution_loss": {"$ref": "#/$defs/distribution"},
        "calibration_transform_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Optional reference to a versioned calibration transform artifact; omitted until a measured calibration exists."
        }
      },
      "required": ["gamut_mapping", "resolution_loss"]
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "distribution_id": {
      "type": "string",
      "minLength": 1
    },
    "parameter_manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geometry": {"$ref": "#/$defs/geometryGroup"},
        "imaging": {"$ref": "#/$defs/imagingGroup"},
        "garment": {"$ref": "#/$defs/garmentGroup"},
        "print_capture": {"$ref": "#/$defs/printCaptureGroup"}
      },
      "required": ["geometry", "imaging", "garment", "print_capture"]
    },
    "seed": {
      "type": "integer"
    },
    "sampling_reproducibility_note": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable note stating that any sample index is fully reproducible from (distribution_id, parameter_manifest, seed, sample_index) with no hidden entropy source."
    },
    "robustness_surface": {
      "type": "object",
      "additionalProperties": false,
      "description": "Output spec: per-dimension response grid over the sampled dimensions, not a scalar-only summary.",
      "properties": {
        "grid_axes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Names of the dimensions swept on each grid axis (e.g. geometry.scale, imaging.blur)."
        },
        "response_metric": {
          "type": "string",
          "minLength": 1
        },
        "cell_value_type": {
          "enum": ["scalar", "vector", "distribution_summary"]
        },
        "scalar_only_permitted": {
          "const": false,
          "description": "A robustness surface may never collapse to a single scalar average."
        }
      },
      "required": ["grid_axes", "response_metric", "cell_value_type", "scalar_only_permitted"]
    }
  },
  "required": [
    "schema_version",
    "distribution_id",
    "parameter_manifest",
    "seed",
    "sampling_reproducibility_note",
    "robustness_surface"
  ]
}
