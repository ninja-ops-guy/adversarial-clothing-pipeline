{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rac.local/schemas/ctm_matched_null_v1.schema.json",
  "title": "RAC CTM Matched-Property Null v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["null_id","null_type","candidate_sha256","null_sha256","manipulated_feature","matched_properties","tolerance_contract_sha256","design_commit"],
  "properties": {
    "null_id":{"type":"string","minLength":1},
    "null_type":{"enum":["NULL-COLOR-MATCHED","NULL-SPECTRAL-MATCHED","NULL-TOPOLOGY-MATCHED"]},
    "candidate_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "null_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "manipulated_feature":{"type":"string","minLength":1},
    "matched_properties":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "tolerance_contract_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "design_commit":{"type":"string","minLength":1}
  }
}
