{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rac.local/schemas/ctm_genome_v2_register_v1.schema.json",
  "title": "RAC CTM SPEC-8/14 Genome v2 Candidate Register v1 (register only; Genome v1 frozen)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","genome_v1_frozen","entries","register_sha256","register_id"],
  "properties": {
    "schema_version": {"const":"rac-ctm-genome-v2-register/1.0"},
    "genome_v1_frozen": {"const":true},
    "entries": {
      "type":"array",
      "minItems":1,
      "items":{
        "type":"object",
        "additionalProperties": false,
        "required": ["family","feature_definition","invariance_claim","computability_cost","spec7_family_ref","spec7_dependence","status","candidate_id"],
        "properties": {
          "family": {"enum":["persistence_landscape_norms","self_similarity_criticality","harmonic_order_energy_curves","description_length_proxies","region_placement_descriptors","symmetry_enforcement_deltas","landmark_region_density_targeting","template_margin_geometry"]},
          "feature_definition": {"type":"string","minLength":1},
          "invariance_claim": {
            "type":"object",
            "additionalProperties": false,
            "required": ["deformation_group","coarsening_operator","statement"],
            "properties": {
              "deformation_group": {"type":"boolean"},
              "coarsening_operator": {"type":"boolean"},
              "statement": {"type":"string","minLength":1}
            }
          },
          "computability_cost": {"type":"string","minLength":1},
          "spec7_family_ref": {"enum":["harmonic_energy_curve","description_length","group_risk","persistence_summary",null]},
          "spec7_dependence": {"type":"string","minLength":1},
          "source_paper": {"type":"string","minLength":1},
          "measured_effect": {"type":"string","minLength":1},
          "status": {"enum":["registered","v2_candidate","dropped"]},
          "candidate_id": {"type":"string","pattern":"^RAC-CTM-GV2-[0-9a-f]{16}$"}
        }
      }
    },
    "register_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "register_id": {"type":"string","pattern":"^RAC-CTM-GV2-REGISTER-[0-9a-f]{16}$"}
  }
}
