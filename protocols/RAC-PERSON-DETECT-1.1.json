{
  "protocol_id": "RAC-PERSON-DETECT",
  "version": "1.1",
  "task": "person_detection",
  "surrogate_model_set": "PERSON-SUR-v2",
  "heldout_model_set": "PERSON-HO-v2",
  "transforms": {
    "brightness": [
      0.7,
      1,
      1.3
    ],
    "scale": [
      1
    ],
    "blur_sigma": [
      0,
      0.8
    ],
    "rotation_deg": [
      -20,
      0,
      20
    ]
  },
  "criteria": {
    "min_baseline_detection_rate": 0.9,
    "max_candidate_detection_rate": 0.5,
    "min_relative_reduction": 0.25,
    "max_invalid_condition_fraction": 0.1,
    "confidence_level": 0.95
  },
  "physical_required_for": [
    "RAC-P1",
    "RAC-P2",
    "RAC-M1",
    "RAC-M2"
  ],
  "preregistered": true,
  "notes": "Generation 2 protocol. v1 held-out models are now surrogate models; RetinaNet v2 and FCOS are the new unseen held-out set. Their state hashes must be bootstrapped without candidate inference and committed before D2 evaluation."
}
